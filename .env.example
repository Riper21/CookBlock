# ===============================================
# Настройки Telegram-бота «Пищеблок»
# Скопируйте этот файл в .env и впишите свои значения.
# Получение ключей - пошагово в ИНСТРУКЦИЯ_ПОЛЬЗОВАТЕЛЯ.md
# ===============================================

# Токен бота от @BotFather в Telegram
TELEGRAM_BOT_TOKEN=ВАШ_ТЕЛЕГРАМ_ТОКЕН_ОТ_BotFather

# Провайдер нейросети: deepseek (по умолчанию) или gemini
LLM_PROVIDER=deepseek

# API-ключ DeepSeek (получить на https://platform.deepseek.com/ -> API Keys)
DEEPSEEK_API_KEY=sk-ВАШ_КЛЮЧ_DEEPSEEK

# Модель DeepSeek: deepseek-chat (текст) или deepseek-reasoner (текст с рассуждениями).
# ВАЖНО ПРО ФОТО: разбор блюд по фотографии (Vision) работает только с
# мультимодальными моделями. Если ваш ключ/провайдер не поддерживает изображения,
# фото-функция сообщит об этом, остальной функционал будет работать.
LLM_MODEL=deepseek-chat

# Официальный эндпоинт DeepSeek.
# Можно указать любой другой OpenAI-совместимый шлюз (тогда укажите его ключ в DEEPSEEK_API_KEY).
LLM_BASE_URL=https://api.deepseek.com

# Таймаут ответов нейросети в секундах (reasoning-модели думают небыстро).
# По умолчанию 120. При частых ошибках таймаута увеличьте.
LLM_TIMEOUT=120

# Резервный ключ Google Gemini (если решите переключить LLM_PROVIDER=gemini):
# GEMINI_API_KEY=AIzaSy_ВАШ_КЛЮЧ_GEMINI
# GEMINI_MODEL=gemini-2.5-flash

# Модель локального распознавания голоса (Whisper): tiny / base / small.
# tiny - быстро и легко (по умолчанию), base - точнее, small - еще точнее, но медленнее.
# При первом голосовом сообщении модель (~75 МБ для tiny) скачивается с HuggingFace.
WHISPER_MODEL=tiny

# (Опционально) Прокси, если Telegram или API недоступны напрямую:
# PROXY_URL=http://127.0.0.1:10809

# (Опционально) Путь к базе данных SQLite (по умолчанию - nutrition_chef.db рядом с кодом).
# Нужен только для нестандартных схем запуска:
# DB_PATH=

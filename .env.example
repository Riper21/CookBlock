# ===============================================
# Настройки Telegram-бота «Пищеблок»
# ===============================================

# Токен бота от @BotFather в Telegram
TELEGRAM_BOT_TOKEN=ВАШ_ТЕЛЕГРАМ_ТОКЕН_ОТ_BotFather

# Провайдер нейросети: deepseek (рекомендуется) или gemini
LLM_PROVIDER=deepseek

# API-ключ DeepSeek (получить на https://platform.deepseek.com/)
DEEPSEEK_API_KEY=sk-ВАШ_КЛЮЧ_DEEPSEEK

# Модель DeepSeek (deepseek-chat — флагманская V3)
LLM_MODEL=deepseek-chat

# Официальный эндпоинт DeepSeek
LLM_BASE_URL=https://api.deepseek.com

# Резервный ключ Google Gemini (если решите переключить LLM_PROVIDER=gemini):
GEMINI_API_KEY=AIzaSy_ВАШ_КЛЮЧ_GEMINI
GEMINI_MODEL=gemini-2.5-flash

# (Опционально) Прокси, если требуется:
PROXY_URL=
